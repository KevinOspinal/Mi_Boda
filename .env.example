# Copia este archivo a .env y rellena los valores.
# .env NO se sube al repo (está en .gitignore).

# Cadena de conexión Postgres (SOLO servidor, nunca llega al navegador).
# Seenode → Database → Connection string. Si el proveedor exige TLS,
# añade ?sslmode=require al final.
# Formato: postgres://usuario:password@host:puerto/base
NUXT_DATABASE_URL=postgres://user:password@host:5432/mi_boda?sslmode=require

# URL pública del sitio (para meta OG y enlaces absolutos)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Panel de administración (/admin) ---
# Clave compartida para entrar al panel (elige una robusta).
NUXT_ADMIN_PASSWORD=cambia-esta-clave
# Secreto para sellar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_ADMIN_SESSION_PASSWORD=genera-un-secreto-de-64-caracteres
