# Copia este archivo a `.env` y completa con tus credenciales de Supabase.
# Estas variables SOLO se usan en el servidor (nunca llegan al navegador).

# Project Settings → API → Project URL
NUXT_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API → service_role key (SECRETA — no compartir ni commitear)
NUXT_SUPABASE_SERVICE_KEY=eyJhbGciOi...

# URL pública del sitio (para meta OG y enlaces absolutos)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
